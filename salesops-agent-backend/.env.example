# ══════════════════════════════════════════════════════════════════════════
#  QuerySales AI — backend environment
#
#  Copy to `.env` and fill in. `.env` is gitignored — NEVER commit real values.
#
#  These six variables are the WHOLE file, and none of them is a provider
#  credential. There is no shared API key and no system-wide fallback: every
#  user brings their own LLM, embedding, email, ERPNext, Google Places and
#  Google Calendar credentials through the dashboard (Settings), stored
#  AES-256-GCM encrypted and scoped to their account (plan §54 Option A).
#
#  If you are looking for where to put an API key — you are not. The user
#  enters it in Settings and it goes straight into the database, encrypted.
# ══════════════════════════════════════════════════════════════════════════


# ── REQUIRED ──────────────────────────────────────────────────────────────

# Database (Neon Postgres + pgvector)
#
# MUST use the async driver. A plain `postgresql://` URL makes SQLAlchemy fall
# back to the sync psycopg2 dialect and the app dies at import with
# "The asyncio extension requires an async driver".
#
# db/session.py normalises a Neon console URL on the way in (swaps the scheme,
# renames sslmode, strips channel_binding). Alembic swaps asyncpg → psycopg2
# itself for DDL. Paste the Neon URL and it will work.
#
# Enable the extension once per database:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Encryption key — protects every credential users store
#
# 32 random bytes, url-safe base64-encoded (44 characters, ends with '=').
# This ONE key serves both crypto paths:
#   • AES-256-GCM — every per-user credential          (core/crypto.py)
#   • Fernet      — legacy users.google_refresh_token  (core/security.py)
# A Fernet key is by definition url-safe-base64(32 bytes), which is exactly the
# 256-bit key AESGCM needs. Do not invent a shorter or non-base64 value.
#
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  LOSING THIS KEY MAKES EVERY STORED CREDENTIAL PERMANENTLY UNRECOVERABLE.
#     Back it up outside the repository. Rotating it means every user must
#     re-enter their keys. It is never stored in Postgres and never logged.
ENCRYPTION_KEY=

# Neon Auth (Better Auth)
#
# Sign-in happens against Neon Auth directly; the backend only verifies the
# resulting JWT against the JWKS endpoint (EdDSA). There is no local password
# table and no POST /auth/login.
NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json


# ── OPTIONAL ──────────────────────────────────────────────────────────────

# Meta tag injected into the public landing/legal pages served by
# api/endpoints/pages.py. Set it only for your own domain.
GOOGLE_SITE_VERIFICATION=

# Public OAuth client ID handed to the frozen React Native app by
# GET /api/calendar/config. Not a secret, and unused by the web dashboard —
# leave empty unless you are still running salesopsapp/.
GOOGLE_CALENDAR_IOS_CLIENT_ID=
