# ══════════════════════════════════════════════════════════════════════════
#  QuerySales AI — backend environment template
#
#  Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit
#  real keys, and never put any of these in a NEXT_PUBLIC_* frontend variable.
#
#  Only the four variables in REQUIRED are needed to boot. Everything below
#  that is an optional system-wide fallback: LLM, embedding, email, ERPNext,
#  Google Places and Google Calendar are all configured per user from the
#  dashboard (Settings), stored AES-256-GCM encrypted, and resolved at run time
#  by core/user_config.py.
#
#      user's own row  →  the env vars below  →  "not configured"
#
#  Leave a section empty to require every user to bring their own credentials.
# ══════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════
#  REQUIRED
# ══════════════════════════════════════════════════════════════════════════

# ── Database (Neon Postgres + pgvector) ──────────────────────────────────
# MUST use the async driver. A plain `postgresql://` URL makes SQLAlchemy fall
# back to the sync psycopg2 dialect and the app dies at import with
# "The asyncio extension requires an async driver".
# Alembic swaps asyncpg → psycopg2 itself (alembic/env.py); keep asyncpg here.
#
# Enable the extension once per database:  CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Encryption key ───────────────────────────────────────────────────────
# 32 random bytes, url-safe base64-encoded (44 characters, ends with '=').
#
# This ONE key serves both crypto paths:
#   • Fernet        — legacy `users.google_refresh_token` (core/security.py)
#   • AES-256-GCM   — every per-user credential            (core/crypto.py)
# A Fernet key is by definition url-safe-base64(32 bytes), which is exactly the
# 256-bit key AESGCM needs. Do not invent a shorter or non-base64 value.
#
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  LOSING THIS KEY MAKES EVERY STORED CREDENTIAL PERMANENTLY UNRECOVERABLE.
#     Back it up outside the repository. Rotating it requires re-entering every
#     user's API keys. It is never stored in Postgres and never logged.
ENCRYPTION_KEY=

# ── Neon Auth (Better Auth) ──────────────────────────────────────────────
# The backend verifies the session JWT against the JWKS endpoint (EdDSA).
# There is no local password table — sign-in happens against Neon Auth.
NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json


# ══════════════════════════════════════════════════════════════════════════
#  OPTIONAL — system-wide fallbacks
#
#  Each block below is configured per user in the dashboard. Fill one in only
#  if you want a shared default for users who have not set up their own.
# ══════════════════════════════════════════════════════════════════════════

# ── LLM  ·  Settings → AI / LLM ──────────────────────────────────────────
# Any OpenAI-compatible endpoint. Powers agent reasoning and outreach copy.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Embeddings  ·  Settings → Embeddings ─────────────────────────────────
# EMBEDDING_DIMENSION is fixed at 1536 (AGENTS.md Decision D2 — the stored
# pgvector column is vector(1536)). A different value is rejected on save.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536

# ── Email / outreach  ·  Settings → Email ────────────────────────────────
# Gmail requires an App Password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587

# ── ERPNext  ·  Settings → Integrations ──────────────────────────────────
# Leads live in OUR Postgres, user-scoped (Decision D5). ERPNext is only an
# optional outbound tool and must never block a response when unconfigured.
# Token format: api_key:api_secret
ERPNEXT_BASE_URL=
ERPNEXT_API_TOKEN=

# ── Google Places  ·  Settings → Integrations ────────────────────────────
# Business discovery for the chat agent.
GOOGLE_PLACES_API_KEY=

# ── Google Calendar  ·  Settings → Integrations ──────────────────────────
# Availability lookups and meeting creation for the chat agent.
# Users normally authorise their own calendar through Connect Calendar, which
# stores a refresh token encrypted against their account. Set a refresh token
# here only for a headless setup (see scripts/get_google_token.py).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=


# ══════════════════════════════════════════════════════════════════════════
#  LEGACY — conversational chat orchestrator
#
#  agent_core/orchestrator.py still builds module-level clients from these at
#  import time (AGENTS.md Decision D1 keeps it as-is). The autonomous sales
#  agent does NOT use them — it resolves per-user config. Moving the
#  orchestrator onto per-user config is deferred to P1.
#
#  The orchestrator uses three model tiers; there is no plain GEMINI_MODEL.
#  Without OPENROUTER_API_KEY the CRM agent falls back to the light Gemini tier.
# ══════════════════════════════════════════════════════════════════════════

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL_HEAVY=gemini-2.5-pro
GEMINI_MODEL_MEDIUM=gemini-2.5-flash
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free


# ══════════════════════════════════════════════════════════════════════════
#  OPTIONAL — deployment
# ══════════════════════════════════════════════════════════════════════════

# Injected into the public landing/legal pages served by api/endpoints/pages.py.
# Ships with a working default; override only for your own domain.
GOOGLE_SITE_VERIFICATION=
