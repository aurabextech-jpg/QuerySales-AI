# ── API Configuration ───────────────────────────────────────────────────────────
# Base URL for your SalesOps Agent backend (e.g., http://localhost:8000 or your production URL)
# For Android emulator using localhost, use http://10.0.2.2:8000
API_URL=http://localhost:8000

NEON_AUTH_URL=auth-url
# ── Google OAuth Configuration ──────────────────────────────────────────────────
# This MUST match the "Web application" Client ID from your Google Cloud Console.
# It is used by the @react-native-google-signin/google-signin library as the webClientId
# to request a serverAuthCode for offline access.
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# If required by your specific auth setup, you might also need an iOS client ID here.
# GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
